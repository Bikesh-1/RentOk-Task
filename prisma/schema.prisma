generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model VirtualKey {
  id String @id @default(cuid())
  name String
  keyHash String @unique
  budgetLimit Decimal @db.Decimal(12, 8)
  totalSpent Decimal @default(0) @db.Decimal(12, 8)
  reservedAmount Decimal @default(0) @db.Decimal(12, 8)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  usageLogs UsageLog[]
}
model UsageLog {
  id String @id @default(cuid())
  virtualKeyId String
  model String
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCost Decimal @db.Decimal(12, 8)
  status String @default("SUCCESS")
  provider String @default("openai")
  errorMessage String?
  createdAt DateTime @default(now())
  virtualKey VirtualKey @relation(fields: [virtualKeyId], references: [id], onDelete: Cascade)
  @@index([virtualKeyId, createdAt])
  @@index([createdAt])
}
