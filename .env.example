# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Server port (local development)
PORT=5000

# Application environment: development or production
NODE_ENV=development


# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL database connection URL
DATABASE_URL=your_postgresql_database_url


# ==========================================
# ADMIN AUTHENTICATION
# ==========================================

# Secret key used to authenticate admin API requests
ADMIN_API_KEY=your_secure_admin_api_key


# ==========================================
# OPENAI CONFIGURATION (PRIMARY PROVIDER)
# ==========================================

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# Default OpenAI model
OPENAI_DEFAULT_MODEL=your_openai_model


# ==========================================
# GEMINI CONFIGURATION (FALLBACK PROVIDER)
# ==========================================

# Gemini API key (optional)
GEMINI_API_KEY=

# Gemini fallback model (optional)
GEMINI_FALLBACK_MODEL=


# ==========================================
# OPENAI PRICING (USD PER 1 MILLION TOKENS)
# ==========================================

OPENAI_INPUT_USD_PER_1M=0.15
OPENAI_OUTPUT_USD_PER_1M=0.60


# ==========================================
# GEMINI PRICING (USD PER 1 MILLION TOKENS)
# ==========================================

GEMINI_INPUT_USD_PER_1M=0.10
GEMINI_OUTPUT_USD_PER_1M=0.40


# ==========================================
# BUDGET & TOKEN CONFIGURATION
# ==========================================

# Safety multiplier applied to estimated request cost
BUDGET_ESTIMATE_MULTIPLIER=1.5

# Maximum output tokens allowed per request
MAX_OUTPUT_TOKENS=4096
